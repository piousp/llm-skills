{
  "name": "pi-syntax-highlight",
  "version": "0.1.2",
  "private": false,
  "description": "Syntax highlighting for pi: colors tool output (grep, find, ls, bash, read, edit, write), diffs, JSON and assistant markdown, and detects the language of unlabeled code fences.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piousp/llm-skills.git",
    "directory": "pi-syntax-highlight"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "syntax-highlighting",
    "highlighting",
    "markdown",
    "code-fences",
    "language-detection",
    "terminal",
    "tui",
    "diff",
    "tool-output",
    "theme"
  ],
  "pi": {
    "image": "https://raw.githubusercontent.com/piousp/llm-skills/main/pi-syntax-highlight/assets/icon.png",
    "extensions": [
      "./extensions"
    ]
  },
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test test/unit/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:types": "npm run typecheck"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "dependencies": {
    "diff": "^8.0.4"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
