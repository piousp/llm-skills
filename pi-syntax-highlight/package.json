{
  "name": "pi-syntax-highlight",
  "version": "0.1.0",
  "private": false,
  "description": "Syntax highlighting for pi tool output (grep, find, ls, bash, read, edit, write) and for assistant markdown (headings, blockquotes, inline code), plus language detection for unlabeled markdown fences.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piousp/llm-skills.git",
    "directory": "pi-syntax-highlight"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test test/unit/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:types": "npm run typecheck"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "dependencies": {
    "diff": "^8.0.4"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
