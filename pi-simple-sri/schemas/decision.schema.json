{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi.dev/schemas/pi-simple-sri/decision@1.json",
  "title": "pi-simple-sri decision record, schema 1",
  "description": "Record written next to a staged lesson candidate. Schema 1 adds the full gate block and replaces the prose predicate of a replay item with the mechanical expectation the gate executes. A change is additive -- and stays in schema 1 -- when it adds an optional key, widens an enum, or adds a branch under gate named after a new basis; a change of the shape or of the meaning of a field already written under schema 1 is schema 2.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "createdAt", "trigger", "skill", "eligibility", "evidence", "diagnosis", "candidate", "gate", "outcome"],
  "properties": {
    "schema": { "const": "pi-simple-sri/decision@1" },
    "createdAt": { "type": "string", "format": "date-time" },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "focus"],
      "properties": {
        "surface": { "enum": ["command", "tool"] },
        "focus": { "type": ["string", "null"] }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "dir", "realDir", "wasSymlink", "eligible"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "dir": { "type": "string", "minLength": 1 },
        "realDir": { "type": "string", "minLength": 1 },
        "wasSymlink": { "type": "boolean" },
        "eligible": { "type": "boolean" }
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow", "deny"],
      "properties": {
        "allow": { "type": "array", "items": { "type": "string" } },
        "deny": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "timestamp", "source"],
        "properties": {
          "id": { "type": "string", "pattern": "^ev-[0-9a-f]{8}$" },
          "kind": { "enum": ["tool_error", "user_correction", "retry_loop", "quality_defect"] },
          "toolName": { "type": "string" },
          "argsHash": { "type": "string" },
          "excerpt": { "type": "string" },
          "timestamp": { "type": "integer" },
          "source": { "enum": ["transcript", "persisted"] },
          "origin": {
            "description": "Where the evidence of a failure that this session did not witness came from: the artifact it was read from and the digest of its bytes. Optional, so every record written before M1c still validates; the keyword that would tie its presence to evidence.kind is a condition on another property, and schema 1 stays additive.",
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "path", "contentHash"],
            "properties": {
              "kind": { "enum": ["review-finding", "rejected-draft"] },
              "path": { "type": "string", "minLength": 1 },
              "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            }
          }
        }
      }
    },
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "failureSignature", "replayItems"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "failureSignature": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "replayItems": {
          "description": "The turns this attempt replays, and how many there are is a property of the base: the base of the transcript needs at least one, and the base of the case bank replays the cases it was written for, which the gate supplies when it runs, so a directional attempt carries none. The keyword was minItems 1 until M1c; relaxing it invalidates no record written before, and the guard that still refuses an empty diagnosis of the transcript lives in src/diagnosis.ts, one per base.",
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["prompt", "cwd", "expectation"],
            "properties": {
              "prompt": { "type": "string", "minLength": 1 },
              "cwd": { "type": "string", "minLength": 1 },
              "model": { "type": "string" },
              "skills": { "type": "array", "items": { "type": "string" } },
              "assistantCycleIndex": { "type": "integer", "minimum": 0 },
              "failingToolCall": { "type": "string" },
              "failureSignature": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "expectation": {
                "description": "What the replayed turn has to stop doing, as data the gate executes. version is the version of the check and not of the record: a checker that reads a version it does not implement refuses it instead of guessing.",
                "type": "object",
                "additionalProperties": false,
                "required": ["class", "version"],
                "properties": {
                  "class": { "enum": ["tool_error", "retry_loop", "user_correction", "quality_defect"] },
                  "version": { "const": 1 },
                  "tool": { "type": "string", "minLength": 1 },
                  "checks": {
                    "description": "The mechanical predicates of a quality_defect: every check has to pass on the final answer of the replayed turn. Which of value and pattern a check needs follows from its kind, and JSON Schema ties no property to another, so src/checks.ts validates that pair and is the one place a check is executed.",
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["kind"],
                      "properties": {
                        "kind": { "enum": ["contains", "not-contains", "regex", "not-regex"] },
                        "value": { "type": "string", "minLength": 1, "maxLength": 500 },
                        "pattern": { "type": "string", "minLength": 1, "maxLength": 500 },
                        "flags": { "enum": ["", "i"] }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "slug", "title", "lessonPath", "contentHash", "bodyHash"],
      "properties": {
        "kind": { "const": "new-lesson" },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 },
        "title": { "type": "string", "minLength": 1 },
        "targetLesson": { "type": ["string", "null"] },
        "lessonPath": { "type": "string", "minLength": 1 },
        "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "bodyHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "gate": {
      "description": "basis is the discriminator of the block: every field that depends on how the gate decides lives under a key named after the basis (replay, or case-bank since M1c), and the top-level fields -- basis, status, budget, tokens, preregistration -- are neutral to it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "status", "budget", "tokens", "preregistration", "replay"],
      "properties": {
        "basis": {
          "description": "How the gate decides. Schema 1 declares two: a paired replay of the diagnosis and a case bank the user wrote. It was a const until M1c, so the change is the widening of one keyword and every record written before it still validates.",
          "enum": ["replay", "case-bank"]
        },
        "status": { "enum": ["not-run", "preregistered", "gate-accepted", "gate-rejected", "gate-abstained"] },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["plannedRuns", "usedRuns", "interruptedAt"],
          "properties": {
            "plannedRuns": { "type": "integer", "minimum": 0 },
            "usedRuns": { "type": "integer", "minimum": 0 },
            "interruptedAt": { "type": ["integer", "null"] }
          }
        },
        "tokens": {
          "type": "object",
          "additionalProperties": false,
          "required": ["proposal", "incumbent", "candidate", "total"],
          "properties": {
            "proposal": {
              "type": "object",
              "additionalProperties": false,
              "required": ["input", "output"],
              "properties": {
                "input": { "type": "integer", "minimum": 0 },
                "output": { "type": "integer", "minimum": 0 }
              }
            },
            "incumbent": {
              "type": "object",
              "additionalProperties": false,
              "required": ["input", "output"],
              "properties": {
                "input": { "type": "integer", "minimum": 0 },
                "output": { "type": "integer", "minimum": 0 }
              }
            },
            "candidate": {
              "type": "object",
              "additionalProperties": false,
              "required": ["input", "output"],
              "properties": {
                "input": { "type": "integer", "minimum": 0 },
                "output": { "type": "integer", "minimum": 0 }
              }
            },
            "judge": {
              "description": "What the second condition spent, present exactly when a gate of the case-bank base called the judge. total is the sum of the components that are there, so the three of a replay gate still add up on their own and a record written before this key existed means the same thing it did.",
              "type": "object",
              "additionalProperties": false,
              "required": ["input", "output"],
              "properties": {
                "input": { "type": "integer", "minimum": 0 },
                "output": { "type": "integer", "minimum": 0 }
              }
            },
            "total": {
              "type": "object",
              "additionalProperties": false,
              "required": ["input", "output"],
              "properties": {
                "input": { "type": "integer", "minimum": 0 },
                "output": { "type": "integer", "minimum": 0 }
              }
            }
          }
        },
        "preregistration": {
          "description": "What was recorded before the first run of the gate, so the rule cannot be chosen after the result is known.",
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["recordedAt", "threshold", "design", "mde"],
          "properties": {
            "recordedAt": { "type": "string", "format": "date-time" },
            "threshold": {
              "type": "object",
              "additionalProperties": false,
              "required": ["rule", "candidatePasses", "incumbentPassesMax", "version"],
              "properties": {
                "rule": { "enum": ["unanimous-and-strictly-better"] },
                "candidatePasses": { "type": "integer", "minimum": 0 },
                "incumbentPassesMax": { "type": "integer", "minimum": 0 },
                "version": { "const": 1 },
                "judge": {
                  "description": "The second condition, recorded with the rule so it cannot be added or removed once the result is known. Present exactly when the case bank declared a rubric, and then the gate cannot accept without the judge agreeing. rubricHash pins the rubric text, which travels inside the copy of the bank.",
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["required", "rubricHash"],
                  "properties": {
                    "required": { "const": "pass" },
                    "rubricHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
                  }
                }
              }
            },
            "design": {
              "type": "object",
              "additionalProperties": false,
              "required": ["reps", "items", "plannedRuns", "arms"],
              "properties": {
                "reps": { "type": "integer", "minimum": 1 },
                "items": { "type": "integer", "minimum": 1 },
                "plannedRuns": { "type": "integer", "minimum": 0 },
                "arms": { "type": "array", "minItems": 2, "items": { "enum": ["incumbent", "candidate"] } }
              }
            },
            "mde": {
              "type": "object",
              "additionalProperties": false,
              "required": ["basis", "runsPerArm", "resolution", "requiredDifference"],
              "properties": {
                "basis": { "type": "string", "minLength": 1 },
                "runsPerArm": { "type": "integer", "minimum": 1 },
                "resolution": { "type": "number", "minimum": 0 },
                "requiredDifference": { "type": "number", "minimum": 0 }
              }
            },
            "skillContentHash": {
              "description": "The digest of the SKILL.md the gate measured. It is the one field of this block that is neutral to the basis: both bases write it, and it is where the acceptance reads the hash it compares against the skill, because the block of one basis (replay) is null in the base of the other. Optional, so every preregistration written before M1c still validates.",
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "caseBank": {
              "description": "The materials of a gate whose basis is a case bank, as they were read before the first run: the file it was loaded from, the digest of its bytes, the copy that travels with the candidate, the number of cases and the digest of the rubric text when the bank declares one. Absent in a gate whose basis is a replay, and optional here so a preregistration written before M1c keeps validating.",
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "contentHash", "copy", "cases", "rubricHash"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                "copy": { "type": "string", "minLength": 1 },
                "cases": { "type": "integer", "minimum": 0 },
                "rubricHash": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" }
              }
            }
          }
        },
        "replay": {
          "description": "The result of a gate whose basis is a paired replay of the diagnosis. It exists only once the budget was spent or the gate abstained.",
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["completedAt", "verdict", "reason", "items", "arms", "interval", "regressions", "excluded", "overlays"],
          "properties": {
            "completedAt": { "type": "string", "format": "date-time" },
            "verdict": { "enum": ["gate-accepted", "gate-rejected", "gate-abstained"] },
            "reason": { "type": ["string", "null"] },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["index", "failureSignature", "expectation", "model", "reps"],
                "properties": {
                  "index": { "type": "integer", "minimum": 0 },
                  "failureSignature": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                  "model": { "type": "string", "minLength": 1 },
                  "expectation": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["class", "version"],
                    "properties": {
                      "class": { "enum": ["tool_error", "retry_loop", "user_correction", "quality_defect"] },
                      "version": { "const": 1 },
                      "tool": { "type": "string", "minLength": 1 },
                      "checks": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["kind"],
                          "properties": {
                            "kind": { "enum": ["contains", "not-contains", "regex", "not-regex"] },
                            "value": { "type": "string", "minLength": 1, "maxLength": 500 },
                            "pattern": { "type": "string", "minLength": 1, "maxLength": 500 },
                            "flags": { "enum": ["", "i"] }
                          }
                        }
                      }
                    }
                  },
                  "reps": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["arm", "rep", "outcome", "stopReason", "skillLoaded", "usage", "durationMs", "exitCode"],
                      "properties": {
                        "arm": { "enum": ["incumbent", "candidate"] },
                        "rep": { "type": "integer", "minimum": 1 },
                        "outcome": { "enum": ["pass", "fail", "invalid"] },
                        "invalidReason": { "type": "string", "minLength": 1 },
                        "invalidDetail": { "type": "string", "minLength": 1 },
                        "stopReason": { "type": ["string", "null"] },
                        "skillLoaded": { "type": "boolean" },
                        "durationMs": { "type": "number", "minimum": 0 },
                        "exitCode": { "type": ["integer", "null"] },
                        "stream": { "type": "string", "minLength": 1 },
                        "truncatedAt": { "type": "integer", "minimum": 0 },
                        "checkFailures": {
                          "type": "array",
                          "minItems": 1,
                          "items": { "type": "string", "minLength": 1 }
                        },
                        "usage": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["input", "output"],
                          "properties": {
                            "input": { "type": "integer", "minimum": 0 },
                            "output": { "type": "integer", "minimum": 0 }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "arms": {
              "type": "object",
              "additionalProperties": false,
              "required": ["incumbent", "candidate"],
              "properties": {
                "incumbent": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["passes", "runs", "tokens"],
                  "properties": {
                    "passes": { "type": "integer", "minimum": 0 },
                    "runs": { "type": "integer", "minimum": 0 },
                    "tokens": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["input", "output"],
                      "properties": {
                        "input": { "type": "integer", "minimum": 0 },
                        "output": { "type": "integer", "minimum": 0 }
                      }
                    }
                  }
                },
                "candidate": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["passes", "runs", "tokens"],
                  "properties": {
                    "passes": { "type": "integer", "minimum": 0 },
                    "runs": { "type": "integer", "minimum": 0 },
                    "tokens": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["input", "output"],
                      "properties": {
                        "input": { "type": "integer", "minimum": 0 },
                        "output": { "type": "integer", "minimum": 0 }
                      }
                    }
                  }
                }
              }
            },
            "interval": {
              "description": "Descriptive and not decisive: the decision is the preregistered rule, and the intervals say how little the design resolves.",
              "type": "object",
              "additionalProperties": false,
              "required": ["method", "alpha", "incumbent", "candidate", "difference"],
              "properties": {
                "method": { "enum": ["wilson"] },
                "alpha": { "type": "number", "minimum": 0 },
                "incumbent": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["low", "high"],
                  "properties": {
                    "low": { "type": "number" },
                    "high": { "type": "number" }
                  }
                },
                "candidate": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["low", "high"],
                  "properties": {
                    "low": { "type": "number" },
                    "high": { "type": "number" }
                  }
                },
                "difference": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["low", "high"],
                  "properties": {
                    "low": { "type": "number" },
                    "high": { "type": "number" }
                  }
                }
              }
            },
            "regressions": { "type": "integer", "minimum": 0 },
            "excluded": {
              "description": "The replay items the gate did not run, each with the failure it names and why it cannot be replayed: an item whose failure is intrinsic to the task is not evidence about the skill.",
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["failureSignature", "reason"],
                "properties": {
                  "failureSignature": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                  "reason": { "enum": ["intrinsic-failure"] }
                }
              }
            },
            "overlays": {
              "type": "object",
              "additionalProperties": false,
              "required": ["incumbent", "candidate", "skillContentHash", "manifestHash"],
              "properties": {
                "incumbent": { "type": "string", "minLength": 1 },
                "candidate": { "type": "string", "minLength": 1 },
                "skillContentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                "manifestHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
              }
            }
          }
        },
        "caseBank": {
          "description": "The result of a gate whose basis is a case bank the user wrote: one entry per case with the runs of both arms, the tallies, the interval, the second condition of the judge and the overlays the acceptance compares against the skill. Null in the three states of a block whose basis is a replay, and the key absent from those blocks is what additionalProperties: false keeps a decision instead of a hole.",
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["completedAt", "verdict", "reason", "cases", "arms", "interval", "regressions", "judge", "overlays"],
          "properties": {
            "completedAt": { "type": "string", "format": "date-time" },
            "verdict": { "enum": ["gate-accepted", "gate-rejected", "gate-abstained"] },
            "reason": { "type": ["string", "null"] },
            "cases": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["index", "id", "model", "checks", "reps"],
                "properties": {
                  "index": { "type": "integer", "minimum": 0 },
                  "id": { "type": "string", "minLength": 1 },
                  "model": { "type": "string", "minLength": 1 },
                  "checks": {
                    "description": "The predicates the runs of the case were judged by, copied from the bank so the record of the gate stands alone. It is the same vocabulary the expectation of a quality_defect uses, and src/checks.ts is still the one place it is executed.",
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["kind"],
                      "properties": {
                        "kind": { "enum": ["contains", "not-contains", "regex", "not-regex"] },
                        "value": { "type": "string", "minLength": 1, "maxLength": 500 },
                        "pattern": { "type": "string", "minLength": 1, "maxLength": 500 },
                        "flags": { "enum": ["", "i"] }
                      }
                    }
                  },
                  "reps": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["arm", "rep", "outcome", "stopReason", "skillLoaded", "usage", "durationMs", "exitCode"],
                      "properties": {
                        "arm": { "enum": ["incumbent", "candidate"] },
                        "rep": { "type": "integer", "minimum": 1 },
                        "outcome": { "enum": ["pass", "fail", "invalid"] },
                        "invalidReason": { "type": "string", "minLength": 1 },
                        "invalidDetail": { "type": "string", "minLength": 1 },
                        "stopReason": { "type": ["string", "null"] },
                        "skillLoaded": { "type": "boolean" },
                        "durationMs": { "type": "number", "minimum": 0 },
                        "exitCode": { "type": ["integer", "null"] },
                        "stream": { "type": "string", "minLength": 1 },
                        "truncatedAt": { "type": "integer", "minimum": 0 },
                        "checkFailures": {
                          "type": "array",
                          "minItems": 1,
                          "items": { "type": "string", "minLength": 1 }
                        },
                        "usage": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["input", "output"],
                          "properties": {
                            "input": { "type": "integer", "minimum": 0 },
                            "output": { "type": "integer", "minimum": 0 }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "arms": {
              "type": "object",
              "additionalProperties": false,
              "required": ["incumbent", "candidate"],
              "properties": {
                "incumbent": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["passes", "runs", "tokens"],
                  "properties": {
                    "passes": { "type": "integer", "minimum": 0 },
                    "runs": { "type": "integer", "minimum": 0 },
                    "tokens": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["input", "output"],
                      "properties": {
                        "input": { "type": "integer", "minimum": 0 },
                        "output": { "type": "integer", "minimum": 0 }
                      }
                    }
                  }
                },
                "candidate": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["passes", "runs", "tokens"],
                  "properties": {
                    "passes": { "type": "integer", "minimum": 0 },
                    "runs": { "type": "integer", "minimum": 0 },
                    "tokens": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["input", "output"],
                      "properties": {
                        "input": { "type": "integer", "minimum": 0 },
                        "output": { "type": "integer", "minimum": 0 }
                      }
                    }
                  }
                }
              }
            },
            "interval": {
              "description": "Descriptive and not decisive: the decision is the preregistered rule, and the intervals say how little the design resolves.",
              "type": "object",
              "additionalProperties": false,
              "required": ["method", "alpha", "incumbent", "candidate", "difference"],
              "properties": {
                "method": { "enum": ["wilson"] },
                "alpha": { "type": "number", "minimum": 0 },
                "incumbent": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["low", "high"],
                  "properties": {
                    "low": { "type": "number" },
                    "high": { "type": "number" }
                  }
                },
                "candidate": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["low", "high"],
                  "properties": {
                    "low": { "type": "number" },
                    "high": { "type": "number" }
                  }
                },
                "difference": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["low", "high"],
                  "properties": {
                    "low": { "type": "number" },
                    "high": { "type": "number" }
                  }
                }
              }
            },
            "regressions": { "type": "integer", "minimum": 0 },
            "judge": {
              "description": "The second condition as it answered: the model that judged, the digest of the rubric it applied, the verdict over the whole set -- every case has to pass -- and what it cost. verdict distinguishes the judge that spoke from the one that did not have to (not-run, because the mechanics had already refused), so a reader never guesses which happened. Null when the gate announced no second condition.",
              "type": ["object", "null"],
              "additionalProperties": false,
              "required": ["model", "rubricHash", "verdict", "calls", "tokens"],
              "properties": {
                "model": { "type": "string", "minLength": 1 },
                "rubricHash": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
                "verdict": { "enum": ["pass", "fail", "not-run"] },
                "calls": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["caseId", "verdict", "reason", "usage"],
                    "properties": {
                      "caseId": { "type": "string", "minLength": 1 },
                      "verdict": { "enum": ["pass", "fail"] },
                      "reason": { "type": "string" },
                      "usage": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["input", "output"],
                        "properties": {
                          "input": { "type": "integer", "minimum": 0 },
                          "output": { "type": "integer", "minimum": 0 }
                        }
                      }
                    }
                  }
                },
                "tokens": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["input", "output"],
                  "properties": {
                    "input": { "type": "integer", "minimum": 0 },
                    "output": { "type": "integer", "minimum": 0 }
                  }
                }
              }
            },
            "overlays": {
              "type": "object",
              "additionalProperties": false,
              "required": ["incumbent", "candidate", "skillContentHash", "manifestHash"],
              "properties": {
                "incumbent": { "type": "string", "minLength": 1 },
                "candidate": { "type": "string", "minLength": 1 },
                "skillContentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                "manifestHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
              }
            }
          }
        }
      }
    },
    "outcome": {
      "description": "outcome.status is what the gate decided (or the acceptance after it), and src/types.ts derives it from gate.status with outcomeStatusFor: the schema cannot tie two properties together, so the agreement of the two fields has one owner.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "decidedAt"],
      "properties": {
        "status": { "enum": ["proposed", "not-eligible", "gate-accepted", "gate-rejected", "gate-abstained", "accepted"] },
        "reason": { "type": ["string", "null"] },
        "decidedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  }
}
