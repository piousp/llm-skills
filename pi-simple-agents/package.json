  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.1",
    "@earendil-works/pi-tui": ">=0.84.1",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "^0.84.1",
    "typebox": "^1.3.8",
    "typescript": "^7.0.2"
  }
}
