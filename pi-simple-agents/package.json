{
  "name": "pi-simple-agents",
  "version": "0.11.0",
  "private": false,
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "type": "module",
  "scripts": {
