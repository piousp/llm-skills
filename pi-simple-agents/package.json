{
  "name": "pi-simple-agents",
  "version": "1.5.4",
  "description": "Subagents for pi with no fuss: one Markdown file per agent, one tool call to run it, overrides to fit your workflow.",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piousp/llm-skills.git",
    "directory": "pi-simple-agents"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "subagents",
    "agents",
    "delegation",
    "background-jobs"
  ],
  "pi": {
    "image": "https://raw.githubusercontent.com/piousp/llm-skills/main/pi-simple-agents/assets/icon.png",
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test test/unit/*.test.ts",
    "test:types": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:e2e": "node --experimental-strip-types --test test/e2e/*.test.ts"
  },
  "dependencies": {
    "glob": "^11.0.0",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.4",
    "@earendil-works/pi-tui": ">=1.0.4",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@earendil-works/pi-tui": "^1.2.0",
    "typebox": "^1.3.8",
    "typescript": "^7.0.2"
  }
}
